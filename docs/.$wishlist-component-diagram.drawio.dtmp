        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Wishlist - Diagrama de Componentes\n!theme plain\nskinparam componentStyle rectangle\nskinparam shadowing false\nskinparam packageStyle rectangle\nskinparam defaultFontName Arial\nskinparam ArrowColor #333333\nskinparam PackageBorderColor #555555\nskinparam ComponentBorderColor #333333\n\ntitle Wishlist API — Diagrama de Componentes (Clean Architecture)\n\nactor \&quot;Cliente HTTP\&quot; as Client\n\npackage \&quot;Interfaces\&quot; as Interfaces #E8F4FD {\n  [WishlistController] as Controller\n  [GlobalExceptionHandler] as ExceptionHandler\n  [DTOs\\nResponseDTO / ProductIdsResponseDTO\\nErroResponseDTO] as ApiDtos\n}\n\npackage \&quot;Application\&quot; as Application #E8F8E8 {\n  interface \&quot;WishlistUseCase\&quot; as UseCase\n  [WishlistUseCaseImpl] as UseCaseImpl\n  interface \&quot;WishlistPropertiesProvider\&quot; as PropsProvider\n  [ProductIdsResponse] as AppDto\n}\n\npackage \&quot;Domain\&quot; as Domain #FFF8E1 {\n  [Wishlist] as Entity\n  [ProductId] as VO\n  interface \&quot;WishlistRepository\&quot; as WishlistRepo\n  interface \&quot;ConfigPropertyRepository\&quot; as ConfigRepo\n  [BusinesException\\nNotFoundException] as DomainEx\n}\n\npackage \&quot;Infrastructure\&quot; as Infrastructure #FCE4EC {\n  package \&quot;Config\&quot; {\n    [WishlistConfig] as Config\n    [WishlistPropertiesProviderImpl] as PropsImpl\n    [MongoCollectionInitializer] as Init\n    [OpenApiConfig] as OpenApi\n  }\n\n  package \&quot;Persistence Mongo\&quot; {\n    [WishlistRepositoryMongoImpl] as WishlistRepoImpl\n    [ConfigPropertyMongoRepository] as ConfigRepoImpl\n    [WishlistMongoSpringData] as WishlistSpringData\n    [ConfigPropertyMongoSpringData] as ConfigSpringData\n    [WishlistMapper] as Mapper\n    [WishlistDocumentMongo] as WishlistDoc\n    [ConfigPropertyDocumentMongo] as ConfigDoc\n  }\n}\n\ndatabase \&quot;MongoDB\&quot; as Mongo {\n  collections \&quot;wishlists\&quot; as WishColl\n  collections \&quot;config_properties\&quot; as ConfigColl\n}\n\n&#39; --- Fluxo principal ---\nClient --&gt; Controller : REST /api/wishlists\nClient --&gt; OpenApi : /swagger-ui.html\nController --&gt; UseCase\nController --&gt; ApiDtos\nExceptionHandler ..&gt; DomainEx : trata\nExceptionHandler --&gt; ApiDtos\n\nUseCase &lt;|.. UseCaseImpl\nUseCaseImpl --&gt; WishlistRepo\nUseCaseImpl --&gt; PropsProvider\nUseCaseImpl --&gt; Entity\nUseCaseImpl --&gt; VO\nUseCaseImpl --&gt; AppDto\nUseCaseImpl ..&gt; DomainEx : lança\n\nConfig --&gt; UseCaseImpl : @Bean\nPropsProvider &lt;|.. PropsImpl\nPropsImpl --&gt; ConfigRepo\n\nWishlistRepo &lt;|.. WishlistRepoImpl\nConfigRepo &lt;|.. ConfigRepoImpl\n\nWishlistRepoImpl --&gt; WishlistSpringData\nWishlistRepoImpl --&gt; Mapper\nWishlistRepoImpl --&gt; WishlistDoc\nConfigRepoImpl --&gt; ConfigSpringData\nConfigRepoImpl --&gt; ConfigDoc\nMapper --&gt; WishlistDoc\nMapper --&gt; Entity\n\nWishlistSpringData --&gt; WishColl\nConfigSpringData --&gt; ConfigColl\nInit --&gt; WishColl : cria / seed\nInit --&gt; ConfigColl : cria / seed\\nwishlist.maxProducts\n\nnote right of Domain\n  Núcleo sem dependências\n  de frameworks.\n  Portas (interfaces) definidas aqui;\n  adaptadores na Infrastructure.\nend note\n\nnote bottom of Infrastructure\n  wishlist.repository.type=mongo\n  ativa os adaptadores Mongo.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hWZcFH7SF56iVXLVJxBp-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
