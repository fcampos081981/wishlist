@startuml Wishlist - C4 Overview
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Wishlist API — C4 Model (visão consolidada)

' --- Context actors / systems ---
Person(customer, "Cliente HTTP", "Consome a Wishlist API.")

System_Boundary(wishlist_system, "Wishlist System") {

  Container_Boundary(app, "Wishlist Application\nSpring Boot 4 / Java 25") {

    Component_Ext(interfaces, "Interfaces", "REST", "WishlistController\nGlobalExceptionHandler\nDTOs")
    Component(application, "Application", "Use Cases", "WishlistUseCaseImpl\nWishlistPropertiesProvider")
    Component(domain, "Domain", "Core", "Wishlist, ProductId\nWishlistRepository (porta)\nConfigPropertyRepository (porta)")
    Component(infra, "Infrastructure", "Adapters", "Mongo repositories\nMapStruct / Documents\nConfig & OpenAPI")
  }

  ContainerDb(mongo, "MongoDB", "Document DB", "wishlists\nconfig_properties")
}

Rel(customer, interfaces, "HTTPS / JSON", "/api/wishlists")
Rel(interfaces, application, "Delega")
Rel(application, domain, "Usa entidades e portas")
Rel(infra, domain, "Implementa portas")
Rel(application, infra, "Usa via portas (DI)")
Rel(infra, mongo, "Spring Data MongoDB")

note right of domain
  **Clean Architecture**
  Dependências apontam para dentro:
  Interfaces → Application → Domain
  Infrastructure → Domain (adaptadores)
end note

@enduml
